ion.itemSet.0":"\ubcf4\ud1b5","minimega.playersRequiredToStartTheRound":"\ub77c\uc6b4\ub4dc\ub97c \uc2dc\uc791\ud558\ub824\uba74 \ud50c\ub808\uc774\uc5b4 %1$s\uba85\uc774 \ub354 \ud544\uc694\ud569\ub2c8\ub2e4.","minimega.join":"\ucc38\uac00\ud558\uae30","minimega.legacyhowtoplay.battle.text":"\u00a72\ud50c\ub808\uc774 \ubc29\ubc95: \ubc30\ud2c0 \ubbf8\ub2c8 \uac8c\uc784\u00a7r\n\n\ubc30\ud2c0\uc740 \ucd5c\ud6c4\uc758 1\uc778\uc774 \ub0a8\uc744 \ub54c\uae4c\uc9c0 \uc8fd\uc774\ub294 \uac8c\uc784\uc785\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \uc0dd\uc874\uc744 \uc704\ud574, \uc720\ub9ac\ud55c \uc704\uce58\uc5d0 \uc11c\uae30 \uc704\ud574 \ubb34\uae30\uc640 \ubc29\uc5b4\uad6c, \uc74c\uc2dd\uc774 \ub2f4\uaca8 \uc788\ub294 \uc0c1\uc790\ub97c \ucc3e\uc544\uc57c \ud569\ub2c8\ub2e4.\n\ub9c8\uc9c0\ub9c9\uae4c\uc9c0 \uc0b4\uc544\ub0a8\uc740 \ud50c\ub808\uc774\uc5b4, \ub610\ub294 \ub808\ubca8 \uc2dc\uac04 \uc885\ub8cc\uae4c\uc9c0 \uac00\uc7a5 \ub9ce\uc740 \uc0ac\uc0b4\uc744 \uae30\ub85d\ud55c \ud50c\ub808\uc774\uc5b4\uac00 \uc6b0\uc2b9\uc790\uac00 \ub429\ub2c8\ub2e4!\n\n\u00a79\uac8c\uc784\ud50c\ub808\uc774\u00a7r\n\uac8c\uc784\uc774 \uc2dc\uc791\ub418\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub4e4\uc774 \uac8c\uc784\uc5d0 \ucc38\uac00\ud560 \ub3d9\uc548 \ub85c\ube44 \uad6c\uc5ed\uc5d0\uc11c \uae30\ub2e4\ub9bd\ub2c8\ub2e4. \ub85c\ube44\uc5d0 \ucd5c\uc18c\ud55c\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \ubaa8\uc774\uba74 \ud0c0\uc774\uba38\uac00 \uc2dc\uc791\ub418\uc9c0\ub9cc \ubaa8\ub4e0 \ud50c\ub808\uc774\uc5b4\uac00 %1$s\uc744 \ub20c\ub7ec \uc900\ube44 \uc0c1\ud0dc\uc784\uc744 \uc54c\ub9ac\uba74 \uac8c\uc784\uc774 \ubc14\ub85c \uc2dc\uc791\ub429\ub2c8\ub2e4.\n\ud50c\ub808\uc774\uc5b4\ub4e4\uc774 \uccab \ubc88\uc9f8 \uacbd\uae30\uc7a5\uc5d0 \uc785\uc7a5\ud558\uba74 \ub2e8\uc0c1\uc5d0\uc11c \uc6c0\uc9c1\uc77c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ubaa8\ub450 \ub3c4\ucc29\ud558\uba74 \ud0c0\uc774\uba38\uc758 \uce74\uc6b4\ud2b8\ub2e4\uc6b4\uc774 \uc2dc\uc791\ub418\uace0 \uacbd\uae30\uac00 \uc9c4\ud589\ub429\ub2c8\ub2e4.\n\ud0c0\uc774\uba38\uc758 \uc2dc\uac04\uc774 \ub05d\ub098\uba74 \ud50c\ub808\uc774\uc5b4\ub4e4\uc740 \ub2e8\uc0c1\uc5d0\uc11c \uc6c0\uc9c1\uc77c \uc218 \uc788\uc9c0\ub9cc \uc7a0\uc2dc \ubb34\uc801 \uc0c1\ud0dc\ub97c \uc720\uc9c0\ud558\uae30 \ub54c\ubb38\uc5d0 \uc790\uc720\ub86d\uac8c \ubb34\uae30\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\uc774 \uc720\uc608 \uae30\uac04\uc774 \ub05d\ub098\uba74 \ubc30\ud2c0\uc774 \uc2dc\uc791\ub429\ub2c8\ub2e4!\n\uac01 \ub77c\uc6b4\ub4dc\ub294 \uc815\ud574\uc9c4 \uc2dc\uac04 \ub3d9\uc548 \uacc4\uc18d\ub418\uac70\ub098 \ub2e8 1\uba85\uc758 \uc0dd\uc874 \ud50c\ub808\uc774\uc5b4\uac00 \ub0a8\uc744 \ub54c\uae4c\uc9c0 \uc9c4\ud589\ub429\ub2c8\ub2e4. \uadf8\ub7f0 \ud6c4\uc5d0\ub294 \ub2e4\uc74c \uacbd\uae30\uc7a5\uc73c\ub85c \uc62e\uaca8\uac00\uace0 \uc8fd\uc5c8\ub358 \ud50c\ub808\uc774\uc5b4\uac00 \ubaa8\ub450 \ub2e4\uc2dc \uc0b4\uc544\ub0a9\ub2c8\ub2e4.\n\n\u00a79\uc81c\ud55c \uc0ac\ud56d\u00a7r\n\ubc30\ud2c0\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \uac74\uc124\uc774\ub098 \ucc44\uad11\uc744 \ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc0dd\uc874\uc5d0 \ud544\uc694\ud55c \ubb34\uae30\uc640 \ubc29\uc5b4\uad6c, \uc74c\uc2dd\uc744 \ucc3e\ub294 \ub370 \uc8fc\ub825\ud574\uc57c \ud569\ub2c8\ub2e4!\n\n\u00a79\uad00\uc804\u00a7r\n\ud50c\ub808\uc774\uc5b4\uac00 \uc8fd\uc73c\uba74 \uc0dd\uc874 \ud50c\ub808\uc774\uc5b4\ub97c \ub530\ub77c\uac00\uac70\ub098 \ubc15\uc950, \uc575\ubb34\uc0c8, \uc9dc\uc99d\uc774 \ub610\ub294 \ub5a0\ub2e4\ub2c8\ub294 \uba38\ub9ac\uac00 \ub418\uc5b4 \uacbd\uae30\uc7a5 \uc8fc\ubcc0\uc744 \ub0a0\uba74\uc11c \uad00\uac1d \uc785\uc7a5\uc5d0\uc11c \uc561\uc158\uc744 \uad00\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4!\n\n\u00a79\ub9e4\uce58 \ub9ac\ud3ec\ud2b8\u00a7r\n\ud55c \ub77c\uc6b4\ub4dc\uac00 \ub05d\ub098\uba74 \ud574\ub2f9 \ub77c\uc6b4\ub4dc\uc758 \ud1b5\uacc4\ub97c \ubcf4\uc5ec\uc8fc\ub294 \ub9e4\uce58 \ub9ac\ud3ec\ud2b8\uac00 \uc0dd\uc131\ub429\ub2c8\ub2e4.\n\ub77c\uc6b4\ub4dc\uc5d0\uc11c \ud65c\uc57d\ud55c \uc815\ub3c4\uc5d0 \ub530\ub77c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uba54\ub2ec\uc774 \uc218\uc5ec\ub429\ub2c8\ub2e4.\n\n","minimega.option.smallInventory":"\uc18c\ud615 \uc18c\uc9c0\ud488","minimega.map.glide.cavern":"\ub3d9\uad74","minimega.option.spectatorMode.2":"\ubc15\uc950","minimega.option.spectatorMode.3":"\uafc0\ubc8c","minimega.option.spectatorMode.0":"\uc548 \ubcf4\uc784","minimega.option.allowAllSkins":"\ubaa8\ub4e0 \uce90\ub9ad\ud130 \ud5c8\uc6a9","minimega.map.glide.yeti.description":"\ucc28\uac00\uc6b4 \ube59\uc0b0 \uc9c0\ud615\uc744 \uac00\ub85c\uc9c8\ub7ec \uac70\uc778\ub4e4\uc758 \uc720\uace8\uc744 \ud1b5\uacfc\ud574 \ube44\ud589\ud558\ub2e4 \ubcf4\uba74 \uc78a\ud600\uc9c4 \uc608\ud2f0\ub4e4\uc758 \ub545\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4.","minimega.option.spectatorMode.1":"\uc54c\ub808\uc774","minimega.option.spectatorMode.6":"\uba38\ub9ac","minimega.option.gameSize":"\uac8c\uc784 \uc0ac\uc774\uc988","minimega.option.spectatorMode.4":"\uc575\ubb34\uc0c8","minimega.option.spectatorMode.5":"\uc9dc\uc99d\uc774","minimega.scoreAttack":"\uc810\uc218 \uacf5\uaca9","minimega.lookBehind":"\ub4a4\ub97c \ubcf4\uc138\uc694","minimega.map.glide.shrunk":"\uac70\uc778\uad6d","minimega.map.glide.cavern.description":"\ub3d9\uad74 \uc18d \uace0\ub300 \uc9c0\ud558 \ubb18\uc9c0\uc5d0\uc11c \uc990\uae30\ub294 \ube44\ud589!","minimega.map.glide.kraken":"\ud06c\ub77c\ucf04","minimega.legacyhowtoplay.glide.text":"\u00a72\ud50c\ub808\uc774 \ubc29\ubc95: \ud65c\uacf5 \ubbf8\ub2c8 \uac8c\uc784\u00a7r\n\n\ud65c\uacf5\uc740 \uc18d\uc804\uc18d\uacb0 \ub0a0\uac1c \ubbf8\ub2c8 \uac8c\uc784\uc785\ub2c8\ub2e4. 2\uac00\uc9c0 \ud615\ud0dc\uac00 \uc788\uc2b5\ub2c8\ub2e4:\n\u00a72\uc810\uc218 \uacf5\uaca9:\u00a7r\n\uace0\ub9ac\ub97c \ud1b5\uacfc\ud574 \uc810\uc218\ub97c \ud68d\ub4dd\ud558\uc138\uc694. \uc81c\uc77c \ub192\uc740 \uc810\uc218\ub97c \ud68d\ub4dd\ud55c \ud50c\ub808\uc774\uc5b4\uac00 \uc6b0\uc2b9\uc790\uac00 \ub429\ub2c8\ub2e4. \ub2e8, \uacb0\uc2b9\uc810\uc5d0 \ub3c4\ub2ec\ud558\uc9c0 \ubabb\ud558\uba74 \uc810\uc218\ub294 \ubb34\ud6a8\uac00 \ub429\ub2c8\ub2e4!\n\u00a72\uc2dc\uac04 \uacf5\uaca9:\u00a7r\n\uc18d\ub3c4\uac00 \uad00\uac74\uc785\ub2c8\ub2e4! \uac00\uc7a5 \ube60\ub978 \uc2dc\uac04\uc5d0 \uacb0\uc2b9\uc810\uc5d0 \ub3c4\ub2ec\ud558\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc6b0\uc2b9\uc790\uac00 \ub429\ub2c8\ub2e4.\n\n\u00a79\ub85c\ube44\u00a7r\n\uac8c\uc784\uc774 \uc2dc\uc791\ub418\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub4e4\uc774 \uac8c\uc784\uc5d0 \ucc38\uac00\ud560 \ub3d9\uc548 \ub85c\ube44 \uad6c\uc5ed\uc5d0\uc11c \uae30\ub2e4\ub9bd\ub2c8\ub2e4. \ub85c\ube44\uc5d0 \ucd5c\uc18c\ud55c\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \ubaa8\uc774\uba74 \uce74\uc6b4\ud2b8\ub2e4\uc6b4 \ud0c0\uc774\uba38\uac00 \uc2dc\uc791\ub418\uc9c0\ub9cc \ubaa8\ub4e0 \ud50c\ub808\uc774\uc5b4\uac00 %1$s\uc744 \ub20c\ub7ec \uc900\ube44 \uc0c1\ud0dc\uc784\uc744 \uc54c\ub9ac\uba74 \uac8c\uc784\uc774 \ubc14\ub85c \uc2dc\uc791\ub429\ub2c8\ub2e4.\n\n\u00a79\uac8c\uc784\ud50c\ub808\uc774 - \uc77c\ubc18\u00a7r\n\ud65c\uacf5\uc740 \uc5b4\ub5a0\ud55c \ub3d9\ub825\ub3c4 \uc5c6\uc774 \ube44\ud589\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uae09\uac15\ud558\ud558\uba74 \uc18d\ub825\uc744 \ub0bc \uc218 \uc788\uc9c0\ub9cc \ub108\ubb34 \uae09\uaca9\ud558\uac8c \uc774\ub3d9\ud558\uba74 \uc815\uccb4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\ud65c\uacf5\uc5d0\uc11c\ub294 \uc628\ub09c \uae30\ub958\uc640 \uc18d\ub3c4 \ubd80\uc2a4\ud2b8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uac01 2\uac00\uc9c0 \uc885\ub958\uac00 \uc788\uc2b5\ub2c8\ub2e4:\n\n\u00a79\uc628\ub09c \uae30\ub958\u00a7r\n\uace0\uc815(\ud770\uc0c9)\u00a7r: \uc815\ud574\uc9c4 \uace0\ub3c4\ub85c \ud50c\ub808\uc774\uc5b4\ub97c \ub744\uc6cc\uc90d\ub2c8\ub2e4.\n\u00a7b\uc790\uc5f0(\ud30c\ub780\uc0c9)\u00a7r: \uc18d\ub3c4\uc640 \uac01\ub3c4\uc5d0 \ub530\ub77c \ud50c\ub808\uc774\uc5b4\ub97c \ub744\uc6cc\uc90d\ub2c8\ub2e4; \uc790\uc5f0 \uc628\ub09c \uae30\ub958\uc5d0 \uc624\ub798 \uc788\uc744\uc218\ub85d \ub354 \ub192\uc774 \uc62c\ub77c\uac11\ub2c8\ub2e4.\n\n\u00a79\uc18d\ub3c4 \ubd80\uc2a4\ud2b8\u00a7r\n\u00a7e\ud2b9\uc815 \ubc29\ud5a5(\ub178\ub780\uc0c9)\u00a7r: \ud654\uc0b4\ud45c \ubc29\ud5a5\uc73c\ub85c \ud50c\ub808\uc774\uc5b4\ub97c \ubc00\uc5b4\uc90d\ub2c8\ub2e4.\n\u00a76\uc804\ubc29\ud5a5(\uc8fc\ud669\uc0c9)\u00a7r: \uc785\uc7a5\ud560 \ub54c \ud5a5\ud55c \ubc29\ud5a5\uc73c\ub85c \ud50c\ub808\uc774\uc5b4\ub97c \ubc00\uc5b4\uc90d\ub2c8\ub2e4.\n\n\u00a79\uac8c\uc784\ud50c\ub808\uc774 - \uc810\uc218 \uacf5\uaca9\u00a7r\n\uc810\uc218 \uacf5\uaca9\uc5d0\uc11c\ub294 \uace0\ub9ac\ub97c \ud1b5\uacfc\ud574 \uac00\uc7a5 \uc810\uc218\ub97c \ub9ce\uc774 \ud68d\ub4dd\ud558\ub294 \uac8c \ubaa9\uc801\uc785\ub2c8\ub2e4. \uacb0\uc2b9\uc810\uc5d0 \ub3c4\ub2ec\ud558\uc9c0 \ubabb\ud558\uba74 \uc810\uc218\ub294 \ubb34\ud6a8\uac00 \ub429\ub2c8\ub2e4.\n\n\u00a72\ucd08\ub85d\uc0c9 \u00a7r\uace0\ub9ac = 3\uc810.\n\u00a7e\ub178\ub780\uc0c9 \u00a7r\uace0\ub9ac = 5\uc810.\n\u00a7b\ud30c\ub780\uc0c9 \u00a7r\uace0\ub9ac = 7\uc810.\n\n\uac00\uc7a5 \ub192\uc740 \uc810\uc218\ub85c \uacb0\uc2b9\uc810\uc744 \ud1b5\uacfc\ud558\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc6b0\uc2b9\ud569\ub2c8\ub2e4. \ub3d9\uc810\uc758 \uacbd\uc6b0\uc5d0\ub294 \uac00\uc7a5 \ube60\ub978 \uc2dc\uac04\uc73c\ub85c \ud1b5\uacfc\ud558\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc6b0\uc2b9\ud569\ub2c8\ub2e4.\n\n\u00a79\uac8c\uc784\ud50c\ub808\uc774 - \uc2dc\uac04 \uacf5\uaca9\u00a7r\n\uc2dc\uac04 \uacf5\uaca9\uc5d0\uc11c\ub294 \uc81c\uc77c \uba3c\uc800 \uacb0\uc2b9\uc810\uc5d0 \ub3c4\ub2ec\ud558\ub294 \uac8c \ubaa9\uc801\uc785\ub2c8\ub2e4. 3\ub77c\uc6b4\ub4dc\uc5d0\uc11c \uc81c\uc77c \ube60\ub978 \uc2dc\uac04\uc744 \uae30\ub85d\ud55c \ud50c\ub808\uc774\uc5b4\uac00 \uc6b0\uc2b9\uc790\uac00 \ub429\ub2c8\ub2e4!\n\n\u00a79\uc11c\ub450\ub974\uc138\uc694!\u00a7r\n\ud55c \ud50c\ub808\uc774\uc5b4\uac00 \ucf54\uc2a4\ub97c \ub9c8\uce58\uba74 \ud0c0\uc774\uba38\uac00 \uc2dc\uc791\ub429\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\uac00 \uacb0\uc2b9\uc810\uc5d0 \ub3c4\ub2ec\ud560 \ub54c\ub9c8\ub2e4 \ud0c0\uc774\uba38 \uc2dc\uac04\uc774 \uc9e7\uc544\uc9c0\ub2c8 \uc11c\ub450\ub974\uc138\uc694!\n\n\u00a79\uc194\ub85c\u00a7r\n\ud65c\uacf5\uc5d0\uc11c\ub294 2\uac00\uc9c0 \ud615\ud0dc\ub97c \uc194\ub85c\ub85c \uc5f0\uc2b5\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. %2$s\ub97c \ub20c\ub7ec \uacbd\uc8fc\ub97c \ub2e4\uc2dc \uc2dc\uc791\ud558\uac70\ub098 %3$s\ub97c \ub20c\ub7ec \ub9c8\uc9c0\ub9c9 \uccb4\ud06c\ud3ec\uc778\ud2b8\ub85c \ub3cc\uc544\uac08 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4.\n\n\u00a79\uccb4\ud06c\ud3ec\uc778\ud2b8\u00a7r\n\ud50c\ub808\uc774\uc5b4\uac00 \uc8fd\uc73c\uba74 \ub9c8\uc9c0\ub9c9 \ub3c4\ub2ec\ud588\ub358 \uccb4\ud06c\ud3ec\uc778\ud2b8\uc5d0\uc11c \ub2e4\uc2dc \uc0b4\uc544\ub0a9\ub2c8\ub2e4. \uccb4\ud06c\ud3ec\uc778\ud2b8\ub294 \uc870\uba85\ub4f1\uc73c\ub85c \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uccb4\ud06c\ud3ec\uc778\ud2b8\ub97c \uc9c0\ub0a0 \ub54c\ub294 \"\uccb4\ud06c\ud3ec\uc778\ud2b8!\"\ub77c\ub294 \ud45c\uc2dc\uac00 \ubc18\uc9dd\uc774\uba70 \uc18c\ub9ac\ub3c4 \ub0a9\ub2c8\ub2e4. \ub2e4\uc2dc \uc0b4\uc544\ub0a0 \uc218 \uc788\ub294 \ud69f\uc218\uc5d0\ub294 \uc81c\ud55c\uc774 \uc5c6\uc9c0\ub9cc \uc2dc\uac04\uc740 \uacc4\uc18d \ud750\ub985\ub2c8\ub2e4!\n\n\u00a79\uac8c\uc784 \ud1b5\uacc4\u00a7r\n\uac8c\uc784\uc774 \ub05d\ub098\uba74 \ud574\ub2f9 \uac8c\uc784\uc758 \ud1b5\uacc4\ub97c \ubcf4\uc5ec\uc8fc\ub294 \uc810\uc218\ud310\uc774 \uc0dd\uc131\ub429\ub2c8\ub2e4.\n\uac8c\uc784\uc5d0\uc11c \ud65c\uc57d\ud55c \uc815\ub3c4\uc5d0 \ub530\ub77c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uba54\ub2ec\uc774 \uc218\uc5ec\ub429\ub2c8\ub2e4.\n\n","minimega.option.roundLength":"\ub77c\uc6b4\ub4dc \uc2dc\uac04","minimega.option.spectatorMode":"\uad00\uc804 \ubaa8\ub4dc","minimega.fistfight":"\ud53c\uc2a4\ud2b8\ud30c\uc774\ud2b8","minimega.map.glide.dragon":"\uc6a9","minimega.option.itemSet.5":"\ubb34\uc791\uc704","minimega.option.item